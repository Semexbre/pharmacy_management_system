<section class="card max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-4">Change password</h1>
  <% if (user.must_change_password) { %><p class="mb-4 text-amber-800">Choose a new password before continuing.</p><% } %>
  <form method="post" action="/change-password" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label class="label" for="current_password">Current password</label><input class="input" id="current_password" name="current_password" type="password" autocomplete="current-password" required></div>
    <div><label class="label" for="password">New password (at least 12 characters)</label><input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength="12" required></div>
    <div><label class="label" for="confirm">Confirm new password</label><input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="12" required></div>
    <button class="btn btn-primary">Change password</button>
  </form>
</section>
