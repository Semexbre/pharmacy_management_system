<section class="card max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-4">Sign in</h1>
  <% if (error) { %><p role="alert" class="mb-4 text-red-700"><%= error %></p><% } %>
  <form method="post" action="/login" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label class="label" for="username">Username</label><input id="username" name="username" class="input" autocomplete="username" maxlength="64" required autofocus></div>
    <div><label class="label" for="password">Password</label><input id="password" name="password" type="password" class="input" autocomplete="current-password" required></div>
    <button class="btn btn-primary w-full justify-center">Sign in</button>
  </form>
  <p class="text-sm text-slate-500 mt-4">First run: sign in as admin with admin123, then choose your own password.</p>
</section>
