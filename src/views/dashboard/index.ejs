<h1 class="text-2xl font-bold mb-5">Dashboard</h1>
<form method="get" action="/" class="flex items-end gap-3 mb-4">
  <div><label class="label" for="days">Near-expiry window</label>
    <select class="input" name="days" id="days">
      <% alertTiers.forEach((days) => { %><option value="<%= days %>" <%= days === alertDays ? 'selected' : '' %>><%= days %> days</option><% }) %>
    </select>
  </div>
  <button class="btn btn-secondary">Update</button>
</form>
<%- include('../partials/alertCards') %>
<section class="card">
  <h2 class="text-lg font-semibold">Pharmacy inventory</h2>
  <p class="mt-2 mb-4 text-slate-600">Manage medicines and receive inventory batches.</p>
  <a href="/medicines" class="btn btn-primary">Open inventory</a>
  <p class="mt-5 text-sm text-slate-500">Local server: <span id="server-status" class="text-slate-400">Checking…</span></p>
</section>
